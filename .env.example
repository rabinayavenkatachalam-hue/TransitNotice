# TransitNotice Configuration Environment Variables
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=transitnotice-super-secure-key-chennai-2026-academic

# Database Connection:
# For SQLite (default, zero configuration needed):
DATABASE_URL=sqlite:///transitnotice.db

# For MySQL (production / local MySQL server):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/transitnotice_db?charset=utf8mb4

# Geographical Scope (Single District Configuration)
DEFAULT_DISTRICT=Chennai
DEFAULT_STATE=Tamil Nadu
APP_TIMEZONE=Asia/Kolkata

# Background Scheduler
SCHEDULER_ENABLED=True
SCHEDULER_INTERVAL_MINUTES=30

# Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminTransit@2026
ADMIN_EMAIL=admin@transitnotice.tn.gov.local

# Web Scraper User Agent
SCRAPER_USER_AGENT=TransitNotice-Bot/1.0 (+http://localhost:5000/about; academic public transit monitor)
SCRAPER_REQUEST_TIMEOUT=15
